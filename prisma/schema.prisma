generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  date        DateTime
  endDate     DateTime?
  time        String?
  endTime     String?
  venueName   String
  venueAddress String?
  suburb      String?
  category    String   @default("Community")
  subTags     String[] @default([])
  isLGBTI     Boolean  @default(false)
  isFree      Boolean  @default(false)
  price       String?
  imageUrl    String?
  ticketUrl   String?
  /// Original listing page when it is not the same as the ticket link.
  sourceUrl   String?
  source      String   @default("ticketmaster")
  city        String   @default("Sydney")
  latitude    Float?
  longitude   Float?
  dedupeHash  String   @unique
  promoterId  String?
  views       Int      @default(0)
  ticketClicks Int     @default(0)
  shares       Int     @default(0)
  itineraryAdds Int    @default(0)
  // Data quality
  status         String    @default("SCHEDULED") // SCHEDULED | CANCELLED | POSTPONED | RESCHEDULED | SOLD_OUT
  statusSource   String?
  lastVerifiedAt DateTime?
  sources        String[]  @default([])
  priceMin       Float?
  priceMax       Float?
  feesIncluded   Boolean?
  seriesKey      String?
  recurrence     String?   // DAILY | WEEKLY | FORTNIGHTLY | MONTHLY | RECURRING
  duplicateOfId  String?
  // Visitor details (from the source listing or the organiser; never inferred)
  galleryUrls       String[] @default([])
  accessibilityInfo String?  @db.Text
  ageRestriction    String?
  transportInfo     String?  @db.Text
  /// Optional room size supplied by the organiser. Never inferred.
  capacity          Int?
  organiserName     String?
  organiserUrl      String?
  /// IANA zone for startsAt/endsAt. Derived from the city. Not a public badge.
  timezone        String?
  /// True when the source listed no start time. Ranking treats these as possibly available.
  allDay          Boolean   @default(false)
  startsAt        DateTime?
  endsAt          DateTime?
  /// Internal 0–100 score for ranking and filters. Never send this to the client.
  confidenceScore Int?
  venueId         String?
  venue           Venue?    @relation(fields: [venueId], references: [id], onDelete: SetNull)
  /// Set when a source refresh disagrees with an active organiser override on a safety-sensitive field.
  materialConflict String?
  /// Organiser dashboard URL at the original source, when we know it. Never a ticket link.
  sourceEditUrl    String?
  // Image pipeline
  imageAssetId   String?
  imageLocked    Boolean   @default(false) // admin replaced the artwork; source refreshes must not overwrite it
  imageLookupAt  DateTime? // last attempt to find artwork on the event's own page (og:image / JSON-LD)
  organiserEditedAt DateTime? // the organiser edited this listing; source refreshes must not overwrite their details
  /// Community hub taxonomy (garage-sales, school-fundraisers, …). Null on ingested listings.
  communityKey       String?
  /// null on ingested listings. PENDING_EMAIL | SUBMITTED
  submissionState    String?
  /// null on ingested listings. PENDING | APPROVED | REJECTED | REMOVED
  approvalState      String?
  /// SUBURB hides the street address. PRECISE is an organiser opt-in. Null on ingested listings.
  locationVisibility String?
  /// Soft-delete. The row and CommunityAudit history stay.
  deletedAt          DateTime?
  /// Private organiser email used for the verification code. Never rendered publicly.
  contactEmail       String?
  emailVerifiedAt    DateTime?
  /// Organiser said the photo includes children. Public pages keep the genre placeholder.
  childrenInImage    Boolean  @default(false)
  /// School listings only: organiser confirmed the photo shows no children. Default off.
  imageKidSafe       Boolean  @default(false)
  templateKey        String?
  communityFlags     String[] @default([])
  submitIpHash       String?
  /// sha256 of the manage link. The raw token is only emailed after verification.
  manageTokenHash    String?  @unique
  referrals      EventReferral[]
  imageAsset     ImageAsset? @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)
  imageHistory   ImageHistory[]
  promoter    User?    @relation("PromoterEvents", fields: [promoterId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  savedBy     SavedEvent[]
  attendees   Attendance[]
  promotions  Promotion[]
  localAds    LocalAd[]
  reports     EventReport[]
  claims      EventClaim[]
  signals     EventSignal[]
  togetherItems TogetherItem[]
  campaigns   Campaign[]
  communityAudits CommunityAudit[]
  occurrences   EventOccurrence[]
  sourceRecords SourceRecord[]
  verificationChecks VerificationCheck[]
  managementGrants EventManagementGrant[]
  fieldOverrides   EventFieldOverride[]
  overrideHistory  EventOverrideHistory[]
  editAcks         EventEditAck[]
  venueReports     VenueEventReport[]

  @@index([date])
  @@index([category])
  @@index([isFree])
  @@index([isLGBTI])
  @@index([suburb])
  @@index([city, date])
  @@index([city, date, status])
  @@index([city, category, date])
  @@index([promoterId])
  @@index([dedupeHash])
  @@index([seriesKey])
  @@index([city, date, duplicateOfId])
  @@index([imageAssetId])
  @@index([communityKey, approvalState, date])
  @@index([approvalState, deletedAt])
  @@index([contactEmail])
  @@index([startsAt])
  @@index([venueId])
}

/// One processed source image, keyed by sha1 of its (upgraded) source URL. Shared by every event using that URL.
model ImageAsset {
  id            String    @id // sha1(sourceUrl)
  sourceUrl     String    @db.Text
  contentHash   String?   // sha1 of the original bytes - variants are cached by this
  status        String    @default("PENDING") // PENDING | OK | ENHANCED | LOW_RES | REVIEW | FAILED
  width         Int?
  height        Int?
  format        String?
  bytes         Int?
  originalPath  String?   // cloud_storage_path of the untouched original
  isPublic      Boolean   @default(true)
  variants      Json?     // { card: { w400: {webp, avif}, w800: {...} }, featured: ..., hero: ..., square: ... }
  fit           Json?     // per variant: "cover" | "contain-blur"
  score         Json?     // sharpness, blockiness, entropy, aspect, overall, integrity
  enhanced      Boolean   @default(false)
  note          String?
  attempts      Int       @default(0)
  costUsd       Float     @default(0)
  processedAt   DateTime?
  checkedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  events        Event[]
  localListings LocalListing[]

  @@index([status])
  @@index([contentHash])
  @@index([checkedAt])
}

/// Artwork changes per event (source updates and admin replacements).
model ImageHistory {
  id          String   @id @default(cuid())
  eventId     String
  oldAssetId  String?
  newAssetId  String?
  oldUrl      String?  @db.Text
  newUrl      String?  @db.Text
  reason      String   // SOURCE_UPDATE | ARTWORK_CHANGED | ADMIN_REPLACE | ADMIN_REGENERATE
  createdAt   DateTime @default(now())
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

/// One run of the async image pass - success/rejection/cost stats.
model ImageRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  trigger    String    @default("refresh")
  processed  Int       @default(0)
  ok         Int       @default(0)
  enhanced   Int       @default(0)
  rejected   Int       @default(0) // enhancement failed integrity check - original kept
  review     Int       @default(0)
  failed     Int       @default(0)
  cached     Int       @default(0)
  unchanged  Int       @default(0)
  costUsd    Float     @default(0)
  errors     String?   @db.Text
}

model RefreshLog {
  id        String   @id @default(cuid())
  startedAt DateTime @default(now())
  endedAt   DateTime?
  status    String   @default("running")
  eventsAdded Int    @default(0)
  errors    String?

  @@index([status, endedAt])
}

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String    @unique
  emailVerified       DateTime?
  image               String?
  password            String?
  role                String    @default("CONSUMER") // CONSUMER | PROMOTER | ADMIN
  orgName             String?
  bio                 String?   @db.Text
  website             String?
  homeCity            String    @default("Sydney")
  preferredCategories String[]  @default([])
  preferredCities     String[]  @default([])
  emailOptIn          Boolean   @default(false)
  emailFrequency      String    @default("weekly") // daily | weekly | monthly
  lastDigestAt        DateTime?
  /// Separate from the newsletter. Upcoming saved-event reminders only.
  reminderOptIn       Boolean   @default(false)
  lastWatchDigestAt   DateTime?
  proUntil            DateTime?
  weeklyReport        Boolean   @default(false) // promoter opted in to a weekly emailed performance report
  lastReportAt        DateTime?
  birthYear           Int? // event-goers: year only. Age checks use the youngest age that year could be. Full dates are not stored.
  homePostcode        String?   // optional 4-digit AU postcode; only ever shown to promoters as grouped home areas
  vibeProfile         Json?     // optional vibe answers (lib/vibe-shared.ts); own recommendations + grouped stats only
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  saved           SavedEvent[]
  attending       Attendance[]
  promotedEvents  Event[]          @relation("PromoterEvents")
  promotions      Promotion[]
  following       PromoterFollow[] @relation("Follower")
  followers       PromoterFollow[] @relation("Followed")
  sentRequests    Friendship[]     @relation("Requester")
  receivedRequests Friendship[]    @relation("Addressee")
  suggestions     Suggestion[]
  proPasses       ProPass[]
  localAds        LocalAd[]
  eventReports    EventReport[]
  eventClaims     EventClaim[]
  eventSignals    EventSignal[]
  togetherPlans   TogetherPlan[]
  togetherMembers TogetherMember[]
  venueFollows    VenueFollow[]
  watchNotices    WatchNotice[]
  memberships     OrganisationMembership[]
  venueClaims     VenueClaimRequest[]
  venuePlacements VenuePlacement[]
  editAcks        EventEditAck[]
  venueReports    VenueEventReport[]
  campaigns       Campaign[]
  organiserSubscriptions OrganiserSubscription[]
  sponsorshipLeads SponsorshipLead[]

  @@index([emailOptIn])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SavedEvent {
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([eventId])
}

model Attendance {
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([eventId])
}

/// One signed-in person's interaction with an event (first time only), used for grouped audience insights.
model EventSignal {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  kind      String   // VIEW | TICKET | SHARE | ITINERARY
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId, kind])
  @@index([eventId])
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("PENDING") // PENDING | ACCEPTED
  createdAt   DateTime @default(now())
  requester   User     @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User     @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model PromoterFollow {
  followerId String
  promoterId String
  createdAt  DateTime @default(now())
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  promoter   User     @relation("Followed", fields: [promoterId], references: [id], onDelete: Cascade)

  @@id([followerId, promoterId])
  @@index([promoterId])
}

/// One stable tax-invoice number per purchase id (campaign order, Pro pass, or local ad).
model InvoiceSeq {
  id        String   @id
  number    Int      @unique
  createdAt DateTime @default(now())
}

model Promotion {
  id              String    @id @default(cuid())
  eventId         String
  promoterId      String
  tier            String    // SILVER | BRONZE | GOLD | add-ons: SPOTLIGHT | FRONTROW
  days            Int?
  orderId         String?
  status          String    @default("PENDING") // PENDING | ACTIVE | EXPIRED | CANCELLED
  amountCents     Int
  currency        String    @default("aud")
  stripeSessionId String?   @unique
  paymentMode     String    @default("stripe") // stripe | test
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  promoter        User      @relation(fields: [promoterId], references: [id], onDelete: Cascade)

  @@index([status, endsAt])
  @@index([eventId])
  @@index([promoterId])
  @@index([orderId])
}

/// Local business recommendation (restaurant, bar, parking, experience, service) shown beneath one event. Runs until the event ends.
model LocalAd {
  id              String    @id @default(cuid())
  eventId         String
  promoterId      String
  kind            String    // DINING | BAR | PARKING | EXPERIENCE | SERVICE
  businessName    String
  blurb           String
  address         String?
  url             String
  status          String    @default("PENDING") // PENDING | ACTIVE | CANCELLED
  amountCents     Int
  currency        String    @default("aud")
  stripeSessionId String?   @unique
  paymentMode     String    @default("stripe") // stripe | test
  startsAt        DateTime?
  endsAt          DateTime?
  views           Int       @default(0)
  clicks          Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  promoter        User      @relation(fields: [promoterId], references: [id], onDelete: Cascade)

  @@index([eventId, status, endsAt])
  @@index([promoterId])
}

/// Promoter Pro membership pass (30 days per purchase)
model ProPass {
  id              String    @id @default(cuid())
  userId          String
  status          String    @default("PENDING") // PENDING | ACTIVE | CANCELLED
  amountCents     Int
  currency        String    @default("aud")
  stripeSessionId String?   @unique
  paymentMode     String    @default("stripe")
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Suggestion {
  id        String   @id @default(cuid())
  userId    String?
  name      String?
  email     String?
  role      String   @default("CONSUMER")
  message    String    @db.Text
  createdAt  DateTime  @default(now())
  /// Set once the suggestion has gone out in the owner's fortnightly ideas summary.
  digestedAt DateTime?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([digestedAt])
}

/// Owner alerts: fault fingerprints (deduped, throttled emails) and the ideas-summary schedule marker.
model OwnerAlert {
  id            String    @id @default(cuid())
  key           String    @unique
  kind          String    // FAULT | IDEAS_DIGEST
  title         String
  detail        String?   @db.Text
  count         Int       @default(1)
  firstSeen     DateTime  @default(now())
  lastSeen      DateTime  @default(now())
  lastEmailedAt DateTime?

  @@index([kind, lastEmailedAt])
}

/// "Report incorrect details" submissions from visitors, reviewed in /admin/trust.
model EventReport {
  id         String    @id @default(cuid())
  eventId    String
  userId     String?
  reason     String    // WRONG_DATE | WRONG_VENUE | WRONG_PRICE | CANCELLED | DUPLICATE | BROKEN_LINK | OTHER
  details    String?   @db.Text
  email      String?
  status     String    @default("OPEN") // OPEN | RESOLVED | DISMISSED
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([eventId])
  @@index([eventId, status])
}

/// Where event-page visits came from (counted per traffic source), for promoter referral reporting.
model EventReferral {
  id        String   @id @default(cuid())
  eventId   String
  source    String   // OUTZA | SEARCH | SOCIAL | EMAIL | DIRECT | OTHER
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, source])
}

/// Organiser claims on a listing. Approved claims make the claimant the event's promoter.
model EventClaim {
  id          String    @id @default(cuid())
  eventId     String
  userId      String
  orgName     String
  position    String?
  evidenceUrl String?
  message     String?   @db.Text
  method      String?   // EMAIL_DOMAIN (auto-verified) | MANUAL
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote  String?
  createdAt   DateTime  @default(now())
  reviewedAt  DateTime?
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([status, createdAt])
}

/// One newsletter issue sent (or test-sent / skipped / blocked by QA) to one subscriber.
model NewsletterSend {
  id        String    @id @default(cuid())
  userId    String
  city      String
  edition   String    // weekly | daily | monthly
  subject   String
  preview   String
  variant   String    @default("") // subject style tested (playful | curious | event-led)
  cta       String    @default("") // CTA wording variant
  headline  String    @default("")
  eventIds  String[]  @default([])
  sections  Json?     // { hero, picks[], wildcard, sponsored, sponsoredPos }
  subjects  Json?     // all candidates generated for this issue
  qa        Json?
  status    String    @default("PENDING") // PENDING | SENT | TEST | SKIPPED | BLOCKED | FAILED
  error     String?
  sentAt    DateTime  @default(now())
  openedAt  DateTime?
  clicks    NewsletterClick[]

  @@index([userId, sentAt])
  @@index([sentAt])
  @@index([status])
}

model NewsletterClick {
  id        String   @id @default(cuid())
  sendId    String
  eventId   String?
  placement String   // hero | picks | wildcard | sponsored | explore | footer
  target    String   // detail | ticket | explore | prefs | unsubscribe
  category  String?
  createdAt DateTime @default(now())
  send      NewsletterSend @relation(fields: [sendId], references: [id], onDelete: Cascade)

  @@index([sendId])
  @@index([createdAt])
}

/// Cached AI editorial line per event, regenerated when the grounding facts change.
model EventBlurb {
  eventId   String   @id
  text      String
  model     String
  factsHash String
  createdAt DateTime @default(now())
}

/// VibePeep Local: community-submitted public listings (garage sales, clearances, markets, community activities).
/// Recurring listings are stored once and expanded into occurrences at read time.
model LocalListing {
  id              String    @id @default(cuid())
  userId          String?
  title           String
  category        String    // GARAGE | WAREHOUSE | MARKET | COMMUNITY
  description     String    @db.Text
  address         String
  suburb          String
  postcode        String
  city            String
  lat             Float?
  lng             Float?
  addressVerified Boolean   @default(false)
  startDate       String    // YYYY-MM-DD, first occurrence (local date)
  endDate         String?   // multi-day one-off sales
  startTime       String    // HH:MM
  endTime         String    // HH:MM
  recurrence      String    @default("NONE") // NONE | WEEKLY | FORTNIGHTLY | MONTHLY_NTH
  recurUntil      String?   // YYYY-MM-DD
  priceNote       String?
  organiserName   String
  contactEmail    String
  websiteUrl      String?
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED | REMOVED
  flags           String[]  @default([])
  duplicateOfId   String?
  reportCount     Int       @default(0)
  ipHash          String?
  reviewNote      String?
  sourceName      String?   // set when imported from a public event feed (null = organiser submission)
  sourceKey       String?
  imagePath       String?   // cloud_storage_path of the lister's own image (public, re-encoded WebP)
  imageAssetId    String?   // processed variants of imagePath via the shared image pipeline
  imageAsset      ImageAsset? @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([sourceKey])
  @@index([city, status, expiresAt])
  @@index([status, createdAt])
  @@index([userId])
  @@index([ipHash, createdAt])
  @@index([imageAssetId])
}

/// Moderation and organiser history for a community listing. Removing a listing never deletes these rows.
model CommunityAudit {
  id        String   @id @default(cuid())
  eventId   String
  actorId   String?
  action    String
  detail    String?  @db.Text
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([eventId, createdAt])
  @@index([action, createdAt])
}

/// Email code and magic-link token for one community submission.
model CommunityCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  tokenHash String    @unique
  eventId   String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
  @@index([eventId])
}

/// Counters for community submissions and organic landings. No visitor identity.
model CommunityMetric {
  id        String   @id @default(cuid())
  kind      String
  city      String?
  suburb    String?
  category  String?
  path      String?
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([city, suburb, category])
}

/// Organiser-saved starting point for the next community listing.
model CommunityTemplate {
  id                 String   @id @default(cuid())
  ownerEmail         String
  userId             String?
  title              String
  communityKey       String
  description        String   @db.Text
  suburb             String
  city               String
  startTime          String
  endTime            String?
  recurrence         String   @default("NONE")
  locationVisibility String   @default("SUBURB")
  organiserName      String?
  websiteUrl         String?
  isFree             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([ownerEmail])
}

/// VibePeep Intelligence: approved official data sources (ABS, TfNSW, Destination NSW, TRA, pedestrian counts, Google Business Profile)
model IntelSource {
  key           String    @id // abs_region | abs_seifa | abs_hsi | tfnsw | dnsw | tra | footfall | google_bp
  enabled       Boolean   @default(true)
  status        String    @default("never_run") // never_run | ok | unchanged | running | partial | failed | needs_config
  lastCheckedAt DateTime?
  lastSuccessAt DateTime?
  lastChangeAt  DateTime?
  versionHash   String?   // hash of the last imported payload (change detection)
  latestPeriod  String?
  obsCount      Int       @default(0)
  lastError     String?   @db.Text
  failCount     Int       @default(0)
  config        Json?
  updatedAt     DateTime  @updatedAt
}

model IntelIngestJob {
  id          String    @id @default(cuid())
  source      String
  trigger     String    @default("schedule") // schedule | admin | cron | test
  status      String    @default("running") // running | ok | unchanged | partial | failed
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  rows        Int       @default(0)
  attempts    Int       @default(1)
  versionHash String?
  message     String?   @db.Text

  @@index([source, startedAt])
}

/// Active (last good) version per dataset. Observations of other versions are ignored until swapped in.
model IntelDataset {
  id            String   @id // `${source}:${dataset}`
  source        String
  activeVersion String
  rows          Int      @default(0)
  latestPeriod  String?
  updatedAt     DateTime @updatedAt
}

model IntelObservation {
  id         String   @id @default(cuid())
  source     String
  dataset    String
  version    String
  measure    String
  geoType    String   // AUS | STE | GCCSA | SA4 | SA3 | SA2 | LGA | POA | SAL | STATION | TOURISM
  geoCode    String
  period     String   // YYYY | YYYY-MM | YE-YYYY-MM
  value      Float?
  unit       String?
  unitMult   Int      @default(0)
  adjustment String   @default("") // HSI: SA | ORIG ; '' otherwise
  category   String   @default("")
  obsStatus  String?
  importedAt DateTime @default(now())

  @@unique([source, dataset, version, measure, geoType, geoCode, period, adjustment, category])
  @@index([geoType, geoCode, measure])
  @@index([source, dataset, version])
}

model IntelArea {
  id      String @id // `${geoType}:${code}`
  geoType String
  code    String
  name    String

  @@index([geoType, name])
}

model IntelTransportStop {
  tsn           String   @id
  name          String
  normName      String
  lat           Float
  lng           Float
  modes         String
  facilities    String?  @db.Text
  accessibility String?  @db.Text
  updatedAt     DateTime @updatedAt

  @@index([normName])
}

/// Venue coordinates resolved to official ABS ASGS 2021 areas (point-in-polygon via ABS geo services)
model IntelVenueGeo {
  key        String   @id // rounded "lat,lng"
  lat        Float
  lng        Float
  sa2        String?
  sa2Name    String?
  sa3        String?
  sa3Name    String?
  sa4        String?
  sa4Name    String?
  gccsa      String?
  gccsaName  String?
  state      String?
  lga        String?
  lgaName    String?
  poa        String?
  sal        String?
  salName    String?
  resolvedAt DateTime @default(now())
}

model IntelCache {
  key       String   @id
  data      Json
  createdAt DateTime @default(now())
}

model GoogleBusinessConnection {
  id              String    @id @default(cuid())
  userId          String    @unique
  refreshTokenEnc String    @db.Text // AES-256-GCM, server-side only, never sent to the client
  scope           String?
  googleEmail     String?
  status          String    @default("connected") // connected | needs_location | ok | api_not_approved | error
  accountName     String?
  locationName    String?   // locations/{id}
  locationTitle   String?
  lastSyncAt      DateTime?
  lastError       String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model GoogleBusinessMetric {
  id           String @id @default(cuid())
  connectionId String
  locationName String
  metric       String
  date         String // YYYY-MM-DD
  value        Int

  @@unique([connectionId, locationName, metric, date])
  @@index([connectionId, date])
}

model GoogleBusinessKeyword {
  id           String @id @default(cuid())
  connectionId String
  locationName String
  month        String // YYYY-MM
  keyword      String
  impressions  Int?
  threshold    Int?   // Google reports "fewer than N" for low volumes

  @@unique([connectionId, locationName, month, keyword])
}

model IntelAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  detail    String?  @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Shared shortlist. Anyone with the token link can view, add events, and vote. Not a social graph.
model TogetherPlan {
  id           String    @id @default(cuid())
  token        String    @unique
  name         String
  city         String?
  planDate     DateTime?
  creatorId    String?
  creatorGuest String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  creator      User?     @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  items        TogetherItem[]
  members      TogetherMember[]
  votes        TogetherVote[]

  @@index([creatorId])
  @@index([creatorGuest])
}

/// A shortlisted option. eventId is a public listing. When eventId is null the row is a private stop that never appears on boards or in search.
model TogetherItem {
  id            String    @id @default(cuid())
  planId        String
  eventId       String?
  title         String?
  address       String?
  note          String?
  startTime     String?
  endTime       String?
  stopDate      DateTime?
  latitude      Float?
  longitude     Float?
  addedById     String?
  addedByGuest  String?
  createdAt     DateTime  @default(now())
  plan          TogetherPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  event         Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  votes         TogetherVote[]

  @@unique([planId, eventId])
  @@index([eventId])
  @@index([addedById])
}

/// One row per person on a plan. Signed-in users use userId; guests use a cookie key. Display name is not an account.
model TogetherMember {
  id        String   @id @default(cuid())
  planId    String
  userId    String?
  guestKey  String?
  name      String
  createdAt DateTime @default(now())
  plan      TogetherPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([planId, userId])
  @@unique([planId, guestKey])
  @@index([userId])
  @@index([guestKey])
}

/// One vote per participant on a plan (userId or guestKey). Voting another option moves the vote.
model TogetherVote {
  id        String   @id @default(cuid())
  planId    String
  itemId    String
  userId    String?
  guestKey  String?
  createdAt DateTime @default(now())
  plan      TogetherPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  item      TogetherItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([planId, userId])
  @@unique([planId, guestKey])
  @@index([itemId])
}

/// Venues a signed-in person follows. Interest tags stay on User.preferredCategories.
model VenueFollow {
  userId    String
  venueKey  String
  venueName String
  city      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, venueKey])
  @@index([city])
}

/// One attempt to send a digest, watchlist note, or reminder, plus cron run summaries.
/// `error` is redacted before it is stored. This is the last-send record for admin.
/// `quota` rows count Yahoo SMTP sends toward the daily cap and are hidden from that list.
model MailDelivery {
  id        String   @id @default(cuid())
  kind      String // newsletter | watchlist | reminder | newsletter-run | watchlist-run | quota
  userId    String?
  status    String // sent | test | failed | restricted | disabled | blocked | skipped | ok
  error     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([userId, createdAt])
}

/// Sent watchlist reminder (or match note) so the same event is not emailed twice.
model WatchNotice {
  id        String   @id @default(cuid())
  userId    String
  kind      String // REMINDER
  eventId   String
  sentAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, eventId])
  @@index([userId])
}

/// Audit trail for duplicate merges and expired-listing checks. Rows are never deleted by the quality pass.
model QualityAudit {
  id         String    @id @default(cuid())
  eventId    String?
  action     String // DUPLICATE_MERGED | DUPLICATE_FLAGGED | EXPIRED_HIDDEN | ADMIN_APPROVED | ADMIN_DISMISSED
  detail     String?   @db.Text
  /// null = log only. OPEN needs a decision. APPROVED or DISMISSED is closed.
  status     String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([action, createdAt])
  @@index([eventId])
  @@index([status, action])
}

/// Sellable short-boost placements. Multi-day packages stay on Promotion.
model PlacementInventory {
  id            String     @id
  name          String
  placement     String
  durationKind  String
  minMinutes    Int
  maxMinutes    Int
  priceCents    Int
  impressionCap Int
  guaranteed    String     @db.Text
  estimated     String     @db.Text
  active        Boolean    @default(true)
  campaigns     Campaign[]
}

/// Monthly organiser plan catalogue. A row here is not a charge.
model SubscriptionPlan {
  id            String                   @id
  name          String
  monthlyCents  Int
  features      String[]
  active        Boolean                  @default(true)
  subscriptions OrganiserSubscription[]
}

/// One organiser's monthly plan. No trial. Charges only after checkout consent and a paid Stripe invoice.
model OrganiserSubscription {
  id                   String    @id @default(cuid())
  userId               String
  planId               String
  status               String    @default("PENDING") // PENDING | ACTIVE | PAST_DUE | CANCELLED
  cancelAtPeriodEnd    Boolean   @default(false)
  pendingPlanId        String?
  pendingPlanAt        DateTime?
  amountCents          Int
  currency             String    @default("aud")
  paymentMode          String    @default("stripe")
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  stripeSessionId      String?   @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  consentAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan @relation(fields: [planId], references: [id])
  charges              SubscriptionCharge[]

  @@index([userId, status])
}

/// One paid Stripe invoice for a monthly plan, so renewals have their own tax invoice.
model SubscriptionCharge {
  id                    String   @id
  subscriptionId        String
  userId                String
  amountCents           Int
  currency              String   @default("aud")
  status                String   @default("PAID") // PAID | REFUNDED
  stripePaymentIntentId String?
  hostedUrl             String?
  periodStart           DateTime?
  periodEnd             DateTime?
  createdAt             DateTime @default(now())
  subscription          OrganiserSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([subscriptionId])
}

/// A paid short boost. Stays PENDING until Stripe confirms payment. Never activated from a quote.
model Campaign {
  id                    String    @id @default(cuid())
  promoterId            String
  eventId               String
  inventoryId           String
  city                  String
  category              String
  startsAt              DateTime
  endsAt                DateTime
  impressionCap         Int
  spendCapCents         Int
  amountCents           Int
  currency              String    @default("aud")
  status                String    @default("PENDING") // PENDING | ACTIVE | PAUSED | EXPIRED | CANCELLED | REFUNDED
  paymentMode           String    @default("stripe")
  stripeSessionId       String?   @unique
  stripePaymentIntentId String?
  consentAt             DateTime?
  refundedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  promoter              User      @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  event                 Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inventory             PlacementInventory @relation(fields: [inventoryId], references: [id])
  creative              Creative?
  impressions           Impression[]
  conversions           ConversionEvent[]

  @@index([status, endsAt])
  @@index([promoterId, status])
  @@index([eventId])
  @@index([city, status, startsAt])
}

model Creative {
  id         String   @id @default(cuid())
  campaignId String   @unique
  headline   String
  blurb      String?
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

/// Serves of a boost, summed by hour so a busy night does not insert one row per view.
model Impression {
  id         String   @id @default(cuid())
  campaignId String
  surface    String
  bucket     String
  count      Int      @default(0)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, surface, bucket])
  @@index([campaignId])
}

model ConversionEvent {
  id         String   @id @default(cuid())
  campaignId String
  kind       String // DETAIL | TICKET | REPEAT
  actorHash  String?
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, kind])
  @@index([actorHash, kind, createdAt])
}

/// Quote request when card billing is off. Never a charge.
model SponsorshipLead {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  kind      String
  note      String?  @db.Text
  payload   Json
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, kind, createdAt])
}

/// Stripe event id, so a webhook retry does not apply twice. Deleted if handling fails.
model PaymentEvent {
  id        String   @id
  createdAt DateTime @default(now())
}

/// Aggregated guide conversions. One row per landing path and referrer type.
model LandingStat {
  id          String   @id @default(cuid())
  path        String
  source      String
  views       Int      @default(0)
  detailViews Int      @default(0)
  saves       Int      @default(0)
  leads       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([path, source])
  @@index([source])
}

/// Venue row for hours cross-checks. Hours are stored only when a source supplied them.
/// Profile fields below are additive. claimStatus stays UNCLAIMED until a grant is approved.
model Venue {
  id            String   @id @default(cuid())
  key           String   @unique
  name          String
  city          String
  timezone      String
  latitude      Float?
  longitude     Float?
  openTime      String?
  closeTime     String?
  hoursSource   String?
  address       String?
  website       String?
  /// Domain we already trust for this venue. Never taken from the claim form.
  officialDomain String?
  description   String?  @db.Text
  contactEmail  String?
  contactPhone  String?
  instagram     String?
  facebook      String?
  legalName     String?
  categories    String[] @default([])
  facilities    String[] @default([])
  accessibilityInfo String? @db.Text
  logoUrl       String?
  photos        String[] @default([])
  announcement  String?  @db.Text
  claimStatus   String   @default("UNCLAIMED") // UNCLAIMED | PENDING | CLAIMED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  events        Event[]
  grants        VenueManagementGrant[]
  claims        VenueClaimRequest[]
  audits        VenueAuditLog[]
  analytics     VenueAnalyticsAggregate[]
  reports       VenueEventReport[]
  placements    VenuePlacement[]
  profileChanges VenueProfileChange[]

  @@index([city])
  @@index([claimStatus])
}

/// One normalised occurrence. Derived from the listing; the Event row stays the public record.
model EventOccurrence {
  id         String    @id @default(cuid())
  eventId    String
  startsAt   DateTime
  endsAt     DateTime?
  timezone   String
  allDay     Boolean   @default(false)
  status     String
  recurrence String?
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, startsAt])
  @@index([startsAt])
}

/// Provenance for one source on a listing. Conflicts are recorded; the primary fields are not overwritten.
model SourceRecord {
  id        String   @id @default(cuid())
  eventId   String
  source    String
  sourceUrl String?  @db.Text
  seenAt    DateTime @default(now())
  missing   Boolean  @default(false)
  changed   Boolean  @default(false)
  conflicts Json?
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, source])
  @@index([missing, changed])
}

/// Rule-based check. Outcomes are ok, due, flag, or skipped. Never a guarantee.
model VerificationCheck {
  id        String   @id @default(cuid())
  eventId   String?
  kind      String
  outcome   String
  detail    String?  @db.Text
  createdAt DateTime @default(now())
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([kind, createdAt])
  @@index([eventId])
}

/// Admin counters that have no other table (search-result clicks).
model AnalyticsCounter {
  key       String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// A venue business or an event organiser. Verification is separate from a user login.
model Organisation {
  id                 String   @id @default(cuid())
  name               String
  organisationType   String // VENUE | ORGANISER
  verificationStatus String   @default("UNVERIFIED") // UNVERIFIED | PENDING | VERIFIED | REVOKED
  emailDomain        String?
  website            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  memberships        OrganisationMembership[]
  venueGrants        VenueManagementGrant[]
  eventGrants        EventManagementGrant[]
  venueClaims        VenueClaimRequest[]

  @@index([verificationStatus])
  @@index([emailDomain])
}

model OrganisationMembership {
  id             String    @id @default(cuid())
  userId         String
  organisationId String
  role           String // ADMINISTRATOR | MANAGER | ORGANISER
  status         String    @default("ACTIVE") // ACTIVE | PENDING | REVOKED
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
  @@index([organisationId, status])
}

/// Approved rows are the only venue edit rights. Event.venueId is not a grant.
model VenueManagementGrant {
  id               String    @id @default(cuid())
  venueId          String
  organisationId   String
  permissionScope  String // ADMINISTRATOR | MANAGER
  status           String    @default("PENDING") // PENDING | APPROVED | REVOKED
  approvedAt       DateTime?
  revokedAt        DateTime?
  venue            Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([venueId, status])
  @@index([organisationId, status])
}

model VenueClaimRequest {
  id                     String    @id @default(cuid())
  venueId                String
  claimantUserId         String
  claimantOrganisationId String?
  fullName               String
  roleAtVenue            String?
  businessEmail          String
  verificationMethod     String // BUSINESS_EMAIL | EXISTING_ORG | MANUAL
  evidenceReference      String?
  status                 String    @default("PENDING") // PENDING | APPROVED | REJECTED | EXPIRED | DISPUTE
  riskNote               String?   @db.Text
  submittedAt            DateTime  @default(now())
  reviewedAt             DateTime?
  venue                  Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user                   User      @relation(fields: [claimantUserId], references: [id], onDelete: Cascade)
  organisation           Organisation? @relation(fields: [claimantOrganisationId], references: [id], onDelete: SetNull)

  @@index([venueId, status])
  @@index([claimantUserId, submittedAt])
  @@index([status, submittedAt])
}

/// One-time email code. Same shape as the community hub code: hashed, expiring, attempt-capped.
model EmailVerificationCode {
  id        String    @id @default(cuid())
  purpose   String // VENUE_CLAIM | EVENT_CLAIM
  subjectId String
  email     String
  codeHash  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([purpose, subjectId])
  @@index([email, createdAt])
}

model VenueAuditLog {
  id            String   @id @default(cuid())
  venueId       String
  actorId       String?
  action        String
  previousValue String?  @db.Text
  updatedValue  String?  @db.Text
  createdAt     DateTime @default(now())
  venue         Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, createdAt])
}

model VenueAnalyticsAggregate {
  id         String @id @default(cuid())
  venueId    String
  period     String // YYYY-MM-DD
  metricType String // PROFILE_VIEWS | WEBSITE_CLICKS | DIRECTIONS_CLICKS | SHARES | EVENT_VIEWS
  value      Int    @default(0)
  venue      Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, period, metricType])
}

model VenueEventReport {
  id             String    @id @default(cuid())
  venueId        String
  eventId        String
  reporterUserId String
  reason         String
  details        String?   @db.Text
  status         String    @default("OPEN") // OPEN | IN_REVIEW | RESOLVED | DISMISSED
  caution        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?
  venue          Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
  @@index([venueId, createdAt])
  @@index([reporterUserId, createdAt])
}

model VenueProfileChange {
  id             String    @id @default(cuid())
  venueId        String
  actorId        String
  fieldName      String
  proposedValue  String    @db.Text
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?
  venue          Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, status])
}

model VenuePlacement {
  id              String    @id @default(cuid())
  venueId         String
  userId          String
  product         String // FEATURED | MAP_PIN | CATEGORY | BOOST | PROFILE
  days            Int
  orderId         String?
  status          String    @default("PENDING") // PENDING | ACTIVE | EXPIRED | CANCELLED
  amountCents     Int
  currency        String    @default("aud")
  stripeSessionId String?   @unique
  paymentMode     String    @default("stripe")
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime  @default(now())
  venue           Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([venueId, status])
  @@index([orderId])
}

/// Explicit event management. Independent of any venue grant.
model EventManagementGrant {
  id             String    @id @default(cuid())
  eventId        String
  organisationId String
  status         String    @default("APPROVED") // APPROVED | REVOKED
  approvedAt     DateTime?
  revokedAt      DateTime?
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([eventId, organisationId])
  @@index([organisationId, status])
}

model EventFieldOverride {
  id                       String   @id @default(cuid())
  eventId                  String
  fieldName                String
  overrideValue            String   @db.Text
  originalSourceValue      String?  @db.Text
  updatedBy                String
  authorisedOrganisationId String?
  updatedAt                DateTime @updatedAt
  verificationContext      String?
  active                   Boolean  @default(true)
  event                    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, fieldName])
  @@index([eventId, active])
}

model EventOverrideHistory {
  id            String   @id @default(cuid())
  eventId       String
  fieldName     String
  action        String // SET | RESTORE | CLEAR_MATCH | SOURCE_SNAPSHOT | CONFLICT
  previousValue String?  @db.Text
  updatedValue  String?  @db.Text
  actorId       String?
  createdAt     DateTime @default(now())
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
}

model EventEditAck {
  userId         String
  eventId        String
  acknowledgedAt DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
}

/// Denied permission checks. Not a visitor log.
model SecurityAudit {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String
  detail     String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}
