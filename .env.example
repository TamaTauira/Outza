# OUTZA environment variable names only. No values belong in git.
# The owner holds the values. See docs/handover.md section 6.
# Preview and production share one database. Use a local Postgres URL for local work.

# Set in the hosted environment
DATABASE_URL=
NEXTAUTH_SECRET=
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ABACUSAI_API_KEY=
WEB_APP_ID=
TICKETMASTER_API_KEY=
OZTIX_ALGOLIA_KEY=
AWS_PROFILE=
AWS_REGION=
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=
NOTIF_ID_PROMOTION_PURCHASED=
NOTIF_ID_EVENT_DIGEST=
NOTIF_ID_NEW_SUGGESTION=
NOTIF_ID_LISTING_REPORT_OR_CLAIM=
NOTIF_ID_PROMOTER_PERFORMANCE_REPORT=
NOTIF_ID_IDEAS_SUMMARY_FORTNIGHTLY=

# Read by the app, unset in the hosted environment today
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CRON_SECRET=
NOTIF_ID_SERIOUS_FAULT_ALERT=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INTEL_ENC_KEY=
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
IMPACT_TICKETEK_CATALOG_ID=
TICKETEK_FEED_URL=
TICKETEK_FEED_AUTH=
TICKETEK_IMAGES_ALLOWED=
NEXT_PUBLIC_TICKETEK_AFFILIATE_LINK=

# The Abacus platform injects NEXTAUTH_URL. Leave it unset.
# NEXTAUTH_URL

# Public canonical origin for metadataBase, canonical, Open Graph, Twitter,
# robots, sitemaps, emails and JSON-LD. Leave unset to use
# https://outza-outza.vercel.app. Do not set this to the legacy alias
# https://outza-sepia.vercel.app — that host 308s to the canonical origin
# (next.config.js; also set the same redirect under Vercel → Settings → Domains
# when the dashboard allows it). Use this only for a real custom domain.
# NEXT_PUBLIC_SITE_URL=https://outza-outza.vercel.app
