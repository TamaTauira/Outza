# VibePeep environment variable names only. No values belong in git.
# The owner holds the values. See docs/handover.md section 6.
# Preview and production share one database. Use a local Postgres URL for local work.

# Set in the hosted environment
DATABASE_URL=
NEXTAUTH_SECRET=
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TICKETMASTER_API_KEY=
OZTIX_ALGOLIA_KEY=
AWS_PROFILE=
AWS_REGION=
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=

# Vercel AI Gateway. Deployments authenticate with OIDC (VERCEL_OIDC_TOKEN).
# Local calls need AI_GATEWAY_API_KEY. AI_GATEWAY_MODEL is a live provider/model
# id from https://ai-gateway.vercel.sh/v1/models. Leave it unset to use
# openai/gpt-5.4-mini (text, JSON, and PDF).
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=

# Transactional email via Resend (https://resend.com). Leave RESEND_API_KEY
# empty to keep sending off. From is RESEND_FROM_EMAIL. Leave it empty to use
# VibePeep <onboarding@resend.dev>, which works without a custom domain.
# Do not set a From address on outza.app.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Read by the app, unset in the hosted environment today
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CRON_SECRET=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INTEL_ENC_KEY=
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
IMPACT_TICKETEK_CATALOG_ID=
TICKETEK_FEED_URL=
TICKETEK_FEED_AUTH=
TICKETEK_IMAGES_ALLOWED=
NEXT_PUBLIC_TICKETEK_AFFILIATE_LINK=

# Auth.js origin. Leave unset to use https://outza-outza.vercel.app.
# An abacusai.app value is ignored. Public links use siteUrl():
# NEXT_PUBLIC_SITE_URL, then SITE_URL, then NEXTAUTH_URL / AUTH_URL,
# then the production host. Preview deployments may use VERCEL_URL.
# NEXTAUTH_URL

# Public canonical origin for metadataBase, canonical, Open Graph, Twitter,
# robots, sitemaps, emails and JSON-LD. Leave unset to use
# https://outza-outza.vercel.app. Do not set this to an abacusai.app host or
# the legacy alias https://outza-sepia.vercel.app — that alias 308s to the
# canonical origin (next.config.js; also set the same redirect under
# Vercel → Settings → Domains when the dashboard allows it).
# NEXT_PUBLIC_SITE_URL=https://outza-outza.vercel.app
